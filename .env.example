# Port resolution (Render automatically injects PORT; 5000 is used for local dev)
PORT=5000

# MySQL Database Configuration (Aiven MySQL / Local MySQL)
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=defaultdb

# SSL option for cloud hosted database (set to true for Aiven MySQL)
DB_SSL=true
